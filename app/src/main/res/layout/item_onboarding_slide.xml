<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieSlide"
        android:layout_width="260dp"
        android:layout_height="240dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <TextView
        android:id="@+id/tvSlideTitle"
        style="@style/TextAppearance.ResQMeal.Heading1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:textAlignment="center"
        tools:text="Reduce Food Waste" />

    <TextView
        android:id="@+id/tvSlideDescription"
        style="@style/TextAppearance.ResQMeal.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        tools:text="Connect surplus food from restaurants, messes, and events with people who need it before it goes to waste." />

</LinearLayout>

