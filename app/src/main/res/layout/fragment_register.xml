<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            style="@style/TextAppearance.ResQMeal.Heading1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Join ResQ Meal"
            android:textColor="@color/primary" />

        <TextView
            style="@style/TextAppearance.ResQMeal.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Reduce waste and bring meals to those in need"
            android:textColor="@color/text_secondary" />

        <!-- Role Selection -->
        <TextView
            style="@style/TextAppearance.ResQMeal.BodyBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="I want to:"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggleGroupRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:checkedButton="@id/btnRoleDonor"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoleDonor"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="Donate Food"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRoleReceiver"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:text="Receive / Claim"
                android:textSize="13sp"
                app:cornerRadius="12dp" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Subtype Selection -->
        <TextView
            android:id="@+id/tvTypeLabel"
            style="@style/TextAppearance.ResQMeal.BodyBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Donor Category:"
            android:textColor="@color/text_primary" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTypeDropdown"
            style="@style/Widget.ResQMeal.OutlinedInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Select Type">

            <AutoCompleteTextView
                android:id="@+id/autoCompleteType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="none"
                android:textSize="14sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Full Name -->
        <com.resqmeal.app.views.OutlinedInput
            android:id="@+id/inputName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:inputHint="Full Name or Organization Name" />

        <!-- Email -->
        <com.resqmeal.app.views.OutlinedInput
            android:id="@+id/inputEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="textEmailAddress"
            app:inputHint="Email Address" />

        <!-- Phone -->
        <com.resqmeal.app.views.OutlinedInput
            android:id="@+id/inputPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="phone"
            app:inputHint="10-Digit Mobile Number" />

        <!-- Password -->
        <com.resqmeal.app.views.OutlinedInput
            android:id="@+id/inputPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:inputType="textPassword"
            app:inputHint="Password (min 8 chars, 1 letter, 1 number)" />

        <!-- Register Button -->
        <com.resqmeal.app.views.PrimaryButton
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:buttonText="Create Account" />

        <!-- Already have account -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal">

            <TextView
                style="@style/TextAppearance.ResQMeal.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Already have an account? "
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/btnGoToLogin"
                style="@style/TextAppearance.ResQMeal.BodyBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sign In"
                android:textColor="@color/primary" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
