<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        android:id="@+id/tv_placeholder_title"
        style="@style/TextAppearance.ResQMeal.Heading2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/placeholder_title_default" />

    <TextView
        android:id="@+id/tv_placeholder_message"
        style="@style/TextAppearance.ResQMeal.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/placeholder_message_default"
        android:textColor="@color/text_secondary" />

</LinearLayout>
