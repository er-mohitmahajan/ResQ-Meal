<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TextAppearance.ResQMeal.Heading2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_dashboard_summary" />

        <ProgressBar
            android:id="@+id/progressLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_margin="12dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvDashboardError"
            style="@style/TextAppearance.ResQMeal.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="@color/error" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <com.resqmeal.app.views.StatCard
                android:id="@+id/statUsers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp" />
            <com.resqmeal.app.views.StatCard
                android:id="@+id/statDonors"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp" />
            <com.resqmeal.app.views.StatCard
                android:id="@+id/statReceivers"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp" />
            <com.resqmeal.app.views.StatCard
                android:id="@+id/statActivePosts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp" />
            <com.resqmeal.app.views.StatCard
                android:id="@+id/statPickups"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp" />
            <com.resqmeal.app.views.StatCard
                android:id="@+id/statMeals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp" />
            <com.resqmeal.app.views.StatCard
                android:id="@+id/statApprovals"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginEnd="6dp" />
            <com.resqmeal.app.views.StatCard
                android:id="@+id/statReports"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_marginStart="6dp" />
        </GridLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenApprovals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/admin_open_approvals" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenReports"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_open_reports" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageUsers"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_manage_users" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManagePosts"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/admin_manage_posts" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
