<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="250dp">

                <ImageView
                    android:id="@+id/ivFoodPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/backgrounds/scenic" />

                <com.resqmeal.app.views.StatusChip
                    android:id="@+id/chipStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_margin="16dp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/TextAppearance.ResQMeal.Heading1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Veg Biryani (Cooked)" />

                <TextView
                    android:id="@+id/tvQuantityServings"
                    style="@style/TextAppearance.ResQMeal.BodyBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/primary"
                    tools:text="15 meals • feeds ~15 people" />

                <TextView
                    android:id="@+id/tvDistance"
                    style="@style/TextAppearance.ResQMeal.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="4dp"
                    android:textColor="@color/text_secondary"
                    app:drawableStartCompat="@drawable/ic_location"
                    tools:text="2.4 km away" />

                <TextView
                    android:id="@+id/tvFoodType"
                    style="@style/TextAppearance.ResQMeal.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/primary"
                    tools:text="Veg • Cooked meal" />

                <com.resqmeal.app.views.SectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:headerTitle="Description" />

                <TextView
                    android:id="@+id/tvDescription"
                    style="@style/TextAppearance.ResQMeal.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Cooked fresh for a wedding event. Contains nuts and dairy. Please bring your own containers if possible." />

                <com.resqmeal.app.views.SectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:headerTitle="Timing" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.ResQMeal.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Prepared At" />

                        <TextView
                            android:id="@+id/tvPreparedAt"
                            style="@style/TextAppearance.ResQMeal.BodyBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Oct 24, 10:00 AM" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.ResQMeal.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expiry Countdown" />

                        <TextView
                            android:id="@+id/tvExpiryCountdown"
                            style="@style/TextAppearance.ResQMeal.BodyBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/warning"
                            tools:text="1h 20m remaining" />
                    </LinearLayout>
                </LinearLayout>

                <com.resqmeal.app.views.SectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:headerTitle="Donor Details" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivDonorPhoto"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ResQMeal.Circular"
                        tools:src="@tools:sample/avatars" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvDonorName"
                            style="@style/TextAppearance.ResQMeal.BodyBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Grand Heritage Hotel" />

                        <TextView
                            android:id="@+id/tvDonorType"
                            style="@style/TextAppearance.ResQMeal.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Restaurant" />
                    </LinearLayout>
                </LinearLayout>

                <com.resqmeal.app.views.SectionHeader
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:headerTitle="Pickup Address" />

                <TextView
                    android:id="@+id/tvPickupAddress"
                    style="@style/TextAppearance.ResQMeal.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="123, Main Street, Green Valley, Pune - 411001" />

                <TextView
                    android:id="@+id/tvPickupInstructions"
                    style="@style/TextAppearance.ResQMeal.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_regular"
                    tools:text="Pickup from the kitchen entrance at the back." />

                <com.resqmeal.app.views.PrimaryButton
                    android:id="@+id/btnClaim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="24dp"
                    app:buttonText="Claim Food" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
