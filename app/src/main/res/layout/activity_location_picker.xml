<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/ivCenterPin"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/ic_location"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/accent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAddress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/btnConfirmLocation"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/TextAppearance.ResQMeal.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selected Location"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/tvSelectedAddress"
                style="@style/TextAppearance.ResQMeal.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Fetching address..."
                android:textColor="@color/text_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.resqmeal.app.views.PrimaryButton
        android:id="@+id/btnConfirmLocation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:buttonText="Confirm Location"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCurrentLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="My Location"
        app:backgroundTint="@color/surface"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@+id/cardAddress"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@android:drawable/ic_menu_mylocation"
        app:tint="@color/primary" />

    <!-- Permission Explanation Overlay -->
    <LinearLayout
        android:id="@+id/layoutPermission"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_location"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvPermissionTitle"
            style="@style/TextAppearance.ResQMeal.Heading2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Location Access"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/tvPermissionMessage"
            style="@style/TextAppearance.ResQMeal.Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/location_permission_explanation"
            android:textAlignment="center"
            android:textColor="@color/text_secondary" />

        <com.resqmeal.app.views.PrimaryButton
            android:id="@+id/btnAllowLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:buttonText="@string/allow_location" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
