<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/claimContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <com.resqmeal.app.views.StatusChip
                        android:id="@+id/chipStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/tvTitle"
                        style="@style/TextAppearance.ResQMeal.Heading1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        tools:text="Fresh vegetable biryani" />

                    <TextView
                        android:id="@+id/tvDonor"
                        style="@style/TextAppearance.ResQMeal.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        tools:text="Donated by City Kitchen" />

                    <TextView
                        android:id="@+id/tvClaimedAt"
                        style="@style/TextAppearance.ResQMeal.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        tools:text="Claimed Nov 06, 2026 8:15 PM" />

                    <TextView
                        style="@style/TextAppearance.ResQMeal.BodyBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:gravity="center"
                        android:text="@string/claim_pickup_code_label"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tvPickupCode"
                        style="@style/TextAppearance.ResQMeal.Heading1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:letterSpacing="0.2"
                        android:textColor="@color/primary"
                        tools:text="0427" />

                    <TextView
                        android:id="@+id/tvPickupAddress"
                        style="@style/TextAppearance.ResQMeal.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:drawablePadding="8dp"
                        app:drawableStartCompat="@drawable/ic_location"
                        tools:text="12 Main Street, Pune" />

                    <TextView
                        android:id="@+id/tvPickupInstructions"
                        style="@style/TextAppearance.ResQMeal.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/text_secondary"
                        tools:text="Collect from the kitchen entrance." />

                    <com.resqmeal.app.views.PrimaryButton
                        android:id="@+id/btnNavigate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        app:buttonText="@string/claim_navigate" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelClaim"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:text="@string/claim_cancel"
                        android:textColor="@color/error" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />
</FrameLayout>
