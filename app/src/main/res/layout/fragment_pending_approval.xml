<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <TextView
        android:id="@+id/tv_approval_title"
        style="@style/TextAppearance.ResQMeal.Heading2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/pending_approval_title" />

    <TextView
        android:id="@+id/tv_approval_message"
        style="@style/TextAppearance.ResQMeal.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/pending_approval_message"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tv_rejection_reason"
        style="@style/TextAppearance.ResQMeal.BodyBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textColor="@color/error"
        android:visibility="gone" />

</LinearLayout>
