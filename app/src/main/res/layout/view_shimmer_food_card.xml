<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.ResQMeal.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Shimmer Photo Box & Chip -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/shimmer_base" />

            <View
                android:layout_width="72dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_shimmer_pill" />
        </FrameLayout>

        <!-- Shimmer Text Placeholders -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <View
                android:layout_width="180dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_shimmer_line" />

            <View
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_shimmer_line" />

            <View
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_shimmer_line" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>

