<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    tools:parentTag="com.google.android.material.card.MaterialCardView">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStatNumber"
                style="@style/TextAppearance.ResQMeal.Heading1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                tools:text="42" />

            <TextView
                android:id="@+id/tvStatLabel"
                style="@style/TextAppearance.ResQMeal.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/text_secondary"
                tools:text="Meals Donated" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivStatIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="Stat Icon"
            app:tint="@color/primary" />

    </LinearLayout>
</merge>
